       "\n=== Neural Network Basics ===\n"        "1. Train and test a perceptron on the AND gate\n"        "2. Display activation functions\n"        "3. Demonstrate forward propagation and loss calculation\n"        "4. Train a NumPy neural network on XOR using SGD\n"        "5. Train a NumPy neural network on XOR using Adam\n"        "6. Save and load a scikit-learn model using pickle and joblib\n"        "7. Compare optimizer performance\n"        "8. Exit"    )def main() -> None:    actions = {        "1": show_perceptron,        "2": show_activations,        "3": show_forward_and_loss,        "4": lambda: (            plot_loss(*_history_for_plot("sgd"), "xor_sgd_loss.png")        ),        "5": lambda: (            plot_loss(*_history_for_plot("adam"), "xor_adam_loss.png")        ),        "6": deployment_demo,        "7": compare_optimizers,    }    while True:        print_menu()        choice = input("Choose an option (1-8): ").strip()        if choice == "8":            print("Goodbye! Keep experimenting.")            return        action = actions.get(choice)        if action is None:            print("Please enter a number from 1 to 8.")            continue        try:            action()        except (ValueError, FileNotFoundError, RuntimeError) as error:            print(f"Could not complete that demonstration: {error}")def _history_for_plot(optimizer_name: str) -> Tuple[List[float], str]:    _, history, _ = train_xor(optimizer_name)    return history, optimizer_nameif __name__ == "__main__":    main()
Collapse file‎Week 15-16/src/neural_network.py‎Copy file name to clipboard+136Lines changed: 136 additions & 0 deletionsOriginal file line numberDiff line numberDiff line change@@ -0,0 +1,136 @@"""A small feedforward neural network with manual backpropagation."""from typing import Dict, List, Optionalimport numpy as nptry:    from .activations import sigmoid, sigmoid_derivative_from_output    from .losses import binary_cross_entropy    from .optimizers import Adam, SGDexcept ImportError:  # Supports running this file directly as a script.    from activations import sigmoid, sigmoid_derivative_from_output    from losses import binary_cross_entropy    from optimizers import Adam, SGDclass NeuralNetwork:    """One-hidden-layer network for binary classification, built using NumPy."""    def __init__(        self,        input_size: int = 2,        hidden_size: int = 4,        output_size: int = 1,        optimizer: str = "adam",        learning_rate: Optional[float] = None,        seed: int = 42,    ) -> None:        if min(input_size, hidden_size, output_size) < 1:            raise ValueError("Layer sizes must be at least 1")        if output_size != 1:            raise ValueError("This example supports one binary output")        rng = np.random.default_rng(seed)        self.parameters: Dict[str, np.ndarray] = {            "W1": rng.normal(                0.0, np.sqrt(2.0 / (input_size + hidden_size)),                size=(input_size, hidden_size),            ),            "b1": np.zeros((1, hidden_size)),            "W2": rng.normal(                0.0, np.sqrt(2.0 / (hidden_size + output_size)),                size=(hidden_size, output_size),            ),            "b2": np.zeros((1, output_size)),        }        self.optimizer_name = optimizer.lower()        if self.optimizer_name == "sgd":            self.optimizer = SGD(                learning_rate if learning_rate is not None else 0.8            )        elif self.optimizer_name == "adam":            self.optimizer = Adam(                learning_rate if learning_rate is not None else 0.05            )        else:            raise ValueError("optimizer must be 'sgd' or 'adam'")        self.cache: Dict[str, np.ndarray] = {}    def forward(self, inputs: np.ndarray) -> np.ndarray:        """Compute predictions and cache values needed by backpropagation."""        inputs = np.asarray(inputs, dtype=float)        if inputs.ndim != 2 or inputs.shape[1] != self.parameters["W1"].shape[0]:            raise ValueError("inputs must have shape (samples, input_size)")        z1 = inputs @ self.parameters["W1"] + self.parameters["b1"]        a1 = sigmoid(z1)        z2 = a1 @ self.parameters["W2"] + self.parameters["b2"]        a2 = sigmoid(z2)        self.cache = {"X": inputs, "A1": a1, "A2": a2}        return a2    def backward(self, targets: np.ndarray) -> Dict[str, np.ndarray]:        """Calculate parameter gradients using the chain rule."""        if not self.cache:            raise RuntimeError("Call forward(inputs) before backward(targets)")        targets = np.asarray(targets, dtype=float).reshape(-1, 1)        inputs = self.cache["X"]  # (samples, input_size)        hidden_output = self.cache["A1"]  # (samples, hidden_size)        prediction = self.cache["A2"]  # (samples, 1)        sample_count = inputs.shape[0]        if targets.shape != prediction.shape:            raise ValueError("targets must contain one binary label per sample")        # For sigmoid + BCE, dL/dZ2 simplifies to (prediction - target) / m.        dz2 = (prediction - targets) / sample_count  # (samples, 1)        dw2 = hidden_output.T @ dz2  # (hidden_size, 1)        db2 = np.sum(dz2, axis=0, keepdims=True)  # (1, 1)        # Chain the output error through W2 and the hidden sigmoid activation.        da1 = dz2 @ self.parameters["W2"].T  # (samples, hidden_size)        dz1 = da1 * sigmoid_derivative_from_output(hidden_output)        dw1 = inputs.T @ dz1  # (input_size, hidden_size)        db1 = np.sum(dz1, axis=0, keepdims=True)  # (1, hidden_size)        return {"W1": dw1, "b1": db1, "W2": dw2, "b2": db2}    def train(        self,        inputs: np.ndarray,        targets: np.ndarray,        epochs: int = 10000,        print_every: int = 2000,    ) -> List[float]:        """Train with full-batch gradients and return loss sampled each epoch."""        inputs = np.asarray(inputs, dtype=float)        targets = np.asarray(targets, dtype=float).reshape(-1, 1)        if len(inputs) != len(targets) or len(inputs) == 0:            raise ValueError("inputs and targets must have the same nonzero size")        if epochs < 1 or print_every < 0:            raise ValueError("epochs must be positive and print_every nonnegative")        history: List[float] = []        for epoch in range(1, epochs + 1):            predictions = self.forward(inputs)            loss = binary_cross_entropy(predictions, targets)            history.append(loss)            gradients = self.backward(targets)            self.optimizer.step(self.parameters, gradients)            if print_every and (epoch == 1 or epoch % print_every == 0):                print(                    f"{self.optimizer_name.upper()} epoch {epoch:5d}/{epochs}: "                    f"loss={loss:.6f}"                )        return history    def predict_proba(self, inputs: np.ndarray) -> np.ndarray:        return self.forward(inputs)    def predict(self, inputs: np.ndarray, threshold: float = 0.5) -> np.ndarray:        return (self.predict_proba(inputs) >= threshold).astype(int)def xor_dataset() -> tuple[np.ndarray, np.ndarray]:    """Return the four input/target examples for the XOR truth table."""    inputs = np.array([[0, 0], [0, 1], [1, 0], [1, 1]], dtype=float)    targets = np.array([[0], [1], [1], [0]], dtype=float)    return inputs, targets
Collapse file‎Week 15-16/src/optimizers.py‎Copy file name to clipboard+72Lines changed: 72 additions & 0 deletionsOriginal file line numberDiff line numberDiff line change@@ -0,0 +1,72 @@"""Parameter update algorithms implemented with NumPy."""from typing import Dictimport numpy as npArrayDict = Dict[str, np.ndarray]class SGD:    """Stochastic Gradient Descent (used here with full-batch gradients).    The learning rate controls the size of each step in the direction opposite    the gradient. Steps that are too large can overshoot; small steps train    slowly.    """    def __init__(self, learning_rate: float = 0.1) -> None:        if learning_rate <= 0:            raise ValueError("learning_rate must be positive")        self.learning_rate = learning_rate    def step(self, parameters: ArrayDict, gradients: ArrayDict) -> None:        for name, parameter in parameters.items():            parameter -= self.learning_rate * gradients[name]class Adam:    """Adaptive Moment Estimation with per-parameter state and bias correction."""    def __init__(        self,        learning_rate: float = 0.01,        beta1: float = 0.9,        beta2: float = 0.999,        epsilon: float = 1e-8,    ) -> None:        if learning_rate <= 0:            raise ValueError("learning_rate must be positive")        if not 0 <= beta1 < 1 or not 0 <= beta2 < 1:            raise ValueError("beta1 and beta2 must be in the interval [0, 1)")        if epsilon <= 0:            raise ValueError("epsilon must be positive")        self.learning_rate = learning_rate        self.beta1 = beta1        self.beta2 = beta2        self.epsilon = epsilon        self.time_step = 0        self.first_moments: ArrayDict = {}        self.second_moments: ArrayDict = {}    def step(self, parameters: ArrayDict, gradients: ArrayDict) -> None:        self.time_step += 1        for name, parameter in parameters.items():            gradient = gradients[name]            if name not in self.first_moments:                self.first_moments[name] = np.zeros_like(parameter)                self.second_moments[name] = np.zeros_like(parameter)            first = self.first_moments[name]            second = self.second_moments[name]            first *= self.beta1            first += (1.0 - self.beta1) * gradient            second *= self.beta2            second += (1.0 - self.beta2) * np.square(gradient)            corrected_first = first / (1.0 - self.beta1**self.time_step)            corrected_second = second / (1.0 - self.beta2**self.time_step)            parameter -= self.learning_rate * corrected_first / (                np.sqrt(corrected_second) + self.epsilon            )
Collapse file‎Week 15-16/src/perceptron.py‎Copy file name to clipboard+68Lines changed: 68 additions & 0 deletionsOriginal file line numberDiff line numberDiff line change@@ -0,0 +1,68 @@"""A single-layer perceptron trained with the perceptron learning rule."""import numpy as nptry:    from .activations import stepexcept ImportError:  # Supports running this file directly as a script.    from activations import stepclass Perceptron:    """A linear decision unit followed by a non-differentiable step function.    A single perceptron can separate only linearly separable classes. XOR is    not linearly separable, so it requires a network with a hidden layer.    """    def __init__(        self, input_size: int, learning_rate: float = 0.1, seed: int = 42    ) -> None:        if input_size < 1:            raise ValueError("input_size must be at least 1")        if learning_rate <= 0:            raise ValueError("learning_rate must be positive")        rng = np.random.default_rng(seed)        self.weights = rng.normal(0.0, 0.1, size=input_size)        self.bias = 0.0        self.learning_rate = learning_rate    def predict(self, inputs: np.ndarray) -> np.ndarray:        inputs = np.asarray(inputs, dtype=float)        return step(inputs @ self.weights + self.bias)    def train(        self, inputs: np.ndarray, targets: np.ndarray, epochs: int = 20    ) -> None:        inputs = np.asarray(inputs, dtype=float)        targets = np.asarray(targets, dtype=int).reshape(-1)        if inputs.ndim != 2 or inputs.shape[1] != self.weights.size:            raise ValueError("inputs must have shape (samples, input_size)")        if len(inputs) != len(targets):            raise ValueError("inputs and targets must contain the same samples")        if epochs < 1:            raise ValueError("epochs must be at least 1")        for _ in range(epochs):            errors = targets - self.predict(inputs)            self.weights += self.learning_rate * (inputs.T @ errors)            self.bias += self.learning_rate * np.sum(errors)def and_gate_demo() -> tuple[Perceptron, np.ndarray, np.ndarray]:    """Train and return a perceptron and its predictions on the AND truth table."""    inputs = np.array([[0, 0], [0, 1], [1, 0], [1, 1]], dtype=float)    targets = np.array([0, 0, 0, 1])    model = Perceptron(input_size=2, learning_rate=0.1, seed=42)    model.train(inputs, targets, epochs=30)    return model, inputs, model.predict(inputs)if __name__ == "__main__":    trained, examples, predictions = and_gate_demo()    print("AND gate perceptron")    print(f"Weights: {trained.weights}")    print(f"Bias: {trained.bias:.3f}")    print(f"Predictions: {predictions.tolist()}")    print("Targets:     [0, 0, 0, 1]")    print("A single perceptron cannot represent XOR because XOR is not linearly separable.")
