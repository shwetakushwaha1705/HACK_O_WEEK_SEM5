   scores = np.array([[1.0, 2.0, 3.0]])    print(f"Softmax({scores.tolist()}): {softmax(scores)} (multiclass probabilities)")    print(f"Softmax Jacobian for that row:\n{softmax_jacobian(softmax(scores)[0])}")    print(        "The step function is suitable for a basic perceptron, but its zero "        "gradient prevents gradient-based training. Smooth activations such as "        "sigmoid, tanh, and ReLU are differentiable almost everywhere."    )    curve_x = np.linspace(-6, 6, 300)    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)    plt.figure(figsize=(8, 5))    plt.plot(curve_x, sigmoid(curve_x), label="Sigmoid")    plt.plot(curve_x, relu(curve_x), label="ReLU")    plt.plot(curve_x, tanh(curve_x), label="Tanh")    plt.plot(curve_x, step(curve_x), label="Step")    plt.title("Activation functions")    plt.xlabel("Input")    plt.ylabel("Output")    plt.legend()    plt.grid(alpha=0.25)    plt.tight_layout()    plot_path = OUTPUT_DIR / "activation_functions.png"    plt.savefig(plot_path)    print(f"Saved activation plot to {plot_path}")    plt.show()    plt.close()def show_forward_and_loss() -> None:    inputs, targets = xor_dataset()    model = NeuralNetwork(seed=42, optimizer="adam")    predictions = model.forward(inputs)    print("\nForward propagation example (untrained network)")    print(f"Predicted probabilities:\n{predictions.round(4)}")    print(f"Targets:\n{targets.astype(int)}")    print(f"Binary cross-entropy: {binary_cross_entropy(predictions, targets):.6f}")    print(f"Mean squared error:   {mean_squared_error(predictions, targets):.6f}")def train_xor(    optimizer_name: str, epochs: int = 10000, print_every: int = 2000) -> Tuple[NeuralNetwork, List[float], float]:    inputs, targets = xor_dataset()    model = NeuralNetwork(optimizer=optimizer_name, seed=42)    history = model.train(inputs, targets, epochs=epochs, print_every=print_every)    predictions = model.predict(inputs)    accuracy = float(np.mean(predictions == targets))    print("\nXOR results"