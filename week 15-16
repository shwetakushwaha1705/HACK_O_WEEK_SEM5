Collapse file‎Week 15-16/src/activations.py‎Copy file name to clipboard+56Lines changed: 56 additions & 0 deletionsOriginal file line numberDiff line numberDiff line change@@ -0,0 +1,56 @@"""Common activation functions implemented with NumPy."""import numpy as npdef sigmoid(values: np.ndarray) -> np.ndarray:    """Map values to (0, 1), clipping inputs to avoid exponential overflow."""    values = np.asarray(values, dtype=float)    values = np.clip(values, -500.0, 500.0)    return 1.0 / (1.0 + np.exp(-values))def sigmoid_derivative_from_output(output: np.ndarray) -> np.ndarray:    """Derivative of sigmoid when its already-computed output is available."""    return output * (1.0 - output)def relu(values: np.ndarray) -> np.ndarray:    """Keep positive values and replace negative values with zero."""    return np.maximum(0.0, np.asarray(values, dtype=float))def relu_derivative(values: np.ndarray) -> np.ndarray:    """Derivative of ReLU; its value at zero is defined here as zero."""    return (np.asarray(values) > 0.0).astype(float)def tanh(values: np.ndarray) -> np.ndarray:    """Map values to (-1, 1)."""    return np.tanh(np.asarray(values, dtype=float))def tanh_derivative_from_output(output: np.ndarray) -> np.ndarray:    """Derivative of tanh when its already-computed output is available."""    return 1.0 - np.square(output)def softmax(values: np.ndarray, axis: int = -1) -> np.ndarray:    """Convert scores to probabilities with a max-shift for numerical stability."""    values = np.asarray(values, dtype=float)    shifted = values - np.max(values, axis=axis, keepdims=True)    exponentials = np.exp(shifted)    return exponentials / np.sum(exponentials, axis=axis, keepdims=True)def softmax_jacobian(probabilities: np.ndarray) -> np.ndarray:    """Return the Jacobian of one softmax probability vector with respect to scores."""    probabilities = np.asarray(probabilities, dtype=float)    if probabilities.ndim != 1:        raise ValueError("probabilities must be a one-dimensional vector")    return np.diag(probabilities) - np.outer(probabilities, probabilities)def step(values: np.ndarray) -> np.ndarray:    """Binary perceptron activation: return one at zero or above, otherwise zero."""    return (np.asarray(values) >= 0.0).astype(int)
Collapse file‎Week 15-16/src/deployment.py‎Copy file name to clipboard+86Lines changed: 86 additions & 0 deletionsOriginal file line numberDiff line numberDiff line change@@ -0,0 +1,86 @@"""Train, save, reload, and compare a small scikit-learn classifier."""import picklefrom pathlib import Pathfrom typing import Any, Dictimport joblibimport numpy as npfrom sklearn.datasets import make_classificationfrom sklearn.linear_model import LogisticRegressionfrom sklearn.pipeline import make_pipelinefrom sklearn.preprocessing import StandardScalerMODEL_DIR = Path(__file__).resolve().parent.parent / "models"def train_demo_model() -> tuple[Any, np.ndarray, np.ndarray]:    """Fit a Logistic Regression pipeline on a reproducible sample dataset."""    inputs, labels = make_classification(        n_samples=200,        n_features=4,        n_informative=3,        n_redundant=0,        random_state=42,    )    model = make_pipeline(StandardScaler(), LogisticRegression(random_state=42))    model.fit(inputs, labels)    return model, inputs, labelsdef save_model(model: Any, file_path: Path, method: str) -> None:    """Serialize a model using pickle or joblib."""    file_path.parent.mkdir(parents=True, exist_ok=True)    if method == "pickle":        with file_path.open("wb") as model_file:            pickle.dump(model, model_file)    elif method == "joblib":        joblib.dump(model, file_path)    else:        raise ValueError("method must be 'pickle' or 'joblib'")def load_model(file_path: Path, method: str) -> Any:    """Load a serialized model, reporting missing files clearly.    Pickle and joblib can execute code during deserialization. Only load files    produced by a trusted source.    """    if not file_path.is_file():        raise FileNotFoundError(            f"Model file not found: {file_path}. Run the deployment demo first."        )    if method == "pickle":        with file_path.open("rb") as model_file:            return pickle.load(model_file)    if method == "joblib":        return joblib.load(file_path)    raise ValueError("method must be 'pickle' or 'joblib'")def deployment_demo() -> Dict[str, np.ndarray]:    """Save with both formats and verify predictions survive a reload."""    model, inputs, _ = train_demo_model()    examples = inputs[:5]    before = model.predict(examples)    paths = {        "pickle": MODEL_DIR / "logistic_regression.pkl",        "joblib": MODEL_DIR / "logistic_regression.joblib",    }    results: Dict[str, np.ndarray] = {}    for method, path in paths.items():        save_model(model, path, method)        restored = load_model(path, method)        after = restored.predict(examples)        if not np.array_equal(before, after):            raise RuntimeError(f"{method} model predictions changed after loading")        results[method] = after        print(f"{method}: saved to {path}")        print(f"  predictions before save: {before.tolist()}")        print(f"  predictions after load:  {after.tolist()} (identical)")    print(        "pickle is built into Python; joblib is convenient for NumPy-heavy "        "objects and can handle large arrays efficiently. Both require trusted files."    )    return results
Collapse file‎Week 15-16/src/losses.py‎Copy file name to clipboard+25Lines changed: 25 additions & 0 deletionsOriginal file line numberDiff line numberDiff line change@@ -0,0 +1,25 @@"""Loss functions for comparing predictions with target values."""import numpy as npdef mean_squared_error(    predictions: np.ndarray, targets: np.ndarray) -> float:    """Return the average squared difference between predictions and targets."""    predictions = np.asarray(predictions, dtype=float)    targets = np.asarray(targets, dtype=float)    return float(np.mean(np.square(predictions - targets)))def binary_cross_entropy(    probabilities: np.ndarray, targets: np.ndarray, epsilon: float = 1e-7) -> float:    """Binary cross-entropy, clipping probabilities before taking logarithms."""    probabilities = np.asarray(probabilities, dtype=float)    targets = np.asarray(targets, dtype=float)    probabilities = np.clip(probabilities, epsilon, 1.0 - epsilon)    terms = targets * np.log(probabilities) + (1.0 - targets) * np.log(        1.0 - probabilities    )    return float(-np.mean(terms))
